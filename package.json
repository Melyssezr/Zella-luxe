  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "dev:lan": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && prisma db push --skip-generate && next build",
    "start": "next start -H 0.0.0.0",
